  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug DCA Script (TypeScript)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "--esm", "src/index.ts"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.envrc",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true
    }
  ]
}
